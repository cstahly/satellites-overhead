# Render SELECTED_HOSTNAME and certificate paths before installing this file as
# /etc/nginx/conf.d/sdr.conf on the public EC2 host.

server {
    listen 80;
    listen [::]:80;
    server_name SELECTED_HOSTNAME;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
        auth_basic off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name SELECTED_HOSTNAME;

    ssl_certificate     SELECTED_FULLCHAIN_PATH;
    ssl_certificate_key SELECTED_PRIVATE_KEY_PATH;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    auth_basic "SDR control";
    auth_basic_user_file /etc/nginx/sdr.htpasswd;

    client_max_body_size 10m;

    # Native/mobile clients authenticate inside serve.py with revocable bearer
    # tokens. Keep the two locations exact enough that /api/v1foo cannot bypass
    # the website's Basic Auth boundary.
    location = /api/v1 {
        auth_basic off;
        proxy_pass http://127.0.0.1:18723;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User "";
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ^~ /api/v1/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:18723;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User "";
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:18723;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Remote-User $remote_user;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
